# Copy to `.env` and fill in. Never commit the real `.env`.

# Required. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# Never True in production.
DEBUG=False

# Comma-separated. Required when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma-separated, scheme included, e.g. https://isp.example.com
CSRF_TRUSTED_ORIGINS=

# Omit to use the local SQLite file. Postgres example:
#   DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_URL=
# DB_SSL_REQUIRE=True
# DB_CONN_MAX_AGE=600

TIME_ZONE=Asia/Dhaka
LOG_LEVEL=INFO

# Production TLS knobs (defaults already secure; override only if terminating TLS elsewhere).
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
