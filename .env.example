# Copy to `.env` and fill in. Never commit the real `.env`.

# ---- Required -------------------------------------------------------------

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# Never True in production.
DEBUG=False

# Comma-separated. Required when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma-separated, scheme included, e.g. https://isp.example.com
CSRF_TRUSTED_ORIGINS=

# ---- Database -------------------------------------------------------------

# Omit to use the local SQLite file. Postgres in production:
#   DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_URL=
# DB_SSL_REQUIRE=True
# DB_CONN_MAX_AGE=600

# ---- Cache ----------------------------------------------------------------

# Required once you run more than one gunicorn worker: the login throttle
# counts failures in the cache, and a per-process cache would let each worker
# count separately. Falls back to in-memory when unset.
# REDIS_URL=redis://localhost:6379/0

# ---- Business -------------------------------------------------------------

SITE_NAME=ISP Manager
CURRENCY_SYMBOL=৳
TIME_ZONE=Asia/Dhaka
LOG_LEVEL=INFO

# ---- Security -------------------------------------------------------------

# Moves the Django admin off its default path. Must end with a slash.
# ADMIN_URL=admin/

# Login throttle: failures allowed, and how long the lockout lasts (seconds).
# LOGIN_FAILURE_LIMIT=6
# LOGIN_FAILURE_TIMEOUT=900

# Set True only when a trusted proxy sets X-Forwarded-For; otherwise a client
# can forge its own address and defeat the per-IP throttle.
# TRUST_PROXY_HEADERS=False

# Production TLS knobs (defaults already secure; override only when TLS is
# terminated somewhere else and this app speaks plain HTTP behind it).
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# ---- Server ---------------------------------------------------------------

# WEB_CONCURRENCY=3
# GUNICORN_TIMEOUT=60
